import {
  "moonbitlang/core/debug",
}

supported_targets = "native"

warnings = "-1-2-3-5-6-7-8-10-29"

options(
  link: {
    "native": {
      "cc": "${build.CC}",
      "cc-flags": "${build.CC_FLAGS}",
      "cc-link-flags": "${build.CC_LINK_FLAGS}",
    },
  },
  targets: {
    "key.mbt": [ "native" ],
    "keymodifier.mbt": [ "native" ],
    "key_to_string.mbt": [ "native" ],
    "mousebutton.mbt": [ "native" ],
    "new.mbt": [ "native" ],
    "qapplication.mbt": [ "native" ],
    "qfont.mbt": [ "native" ],
    "qfontmetricsf.mbt": [ "native" ],
    "qpainter.mbt": [ "native" ],
    "qpointf.mbt": [ "native" ],
    "qrectf.mbt": [ "native" ],
    "qsizef.mbt": [ "native" ],
    "qstringlist.mbt": [ "native" ],
    "qstring.mbt": [ "native" ],
    "types.mbt": [ "native" ],
    "window.mbt": [ "native" ],
  },
)
